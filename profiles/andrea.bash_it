# Profilo personale Andrea.
# Sono esclusi i componenti generici che introducono alias distruttivi,
# strumenti legacy o comportamenti automatici non necessari.

# Alias sicuri e utili
aliases bash-it
aliases directory
aliases systemd

# Completamento del sistema e degli strumenti che possono essere presenti.
# gcloud e aliases sono esclusi perché rallentano l'avvio di oltre 2 secondi.
completion system
completion git
completion bash-it
completion ssh
completion kubectl
completion helm
completion github-cli

